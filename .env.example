# Copy to .env (git-ignored) and fill in. Used by docker-compose.yml.
DJANGO_SECRET_KEY=change-me-to-50-random-characters
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
POSTGRES_PASSWORD=change-me
# The shop owner (Django admin + #ledger sign-in). Created/updated on every `migrate` run.
OWNER_EMAIL=owner@solenne.example
OWNER_PASSWORD=change-me-too
# Set to true when nginx is served over HTTPS.
COOKIE_SECURE=false
HTTP_PORT=8080
API_REPLICAS=3
